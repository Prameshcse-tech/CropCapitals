# ===== Server =====
PORT=5000
NODE_ENV=development
# Set NODE_ENV=production on Render — it switches cookies to secure/cross-site mode

# ===== Frontend URL (for CORS) =====
# Local dev:
CLIENT_URL=http://localhost:3000
# On Render, set this to your deployed Vercel URL instead, e.g.:
# CLIENT_URL=https://cropcapitals.vercel.app

# ===== Session =====
SESSION_SECRET=replace_this_with_a_long_random_string

# ===== Supabase Postgres (Database) =====
# Get these from Supabase Dashboard -> Project Settings -> Database -> Connection Info
DB_HOST=your_supabase_db_host
DB_PORT=5432
DB_USER=your_supabase_db_user
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

# ===== Supabase Storage (Image Uploads) =====
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET_NAME=project-images
